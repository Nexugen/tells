# Copy to /etc/tells-api.env (mode 600). Lint works with none of this set.
TELLS_HOST=127.0.0.1
TELLS_PORT=3891
TELLS_TRUST_PROXY=1
# Rewrite needs a model. "anthropic" uses ANTHROPIC_API_KEY. "cli" runs the Claude Code CLI
# (claude -p, no tools) with the login in TELLS_CLI_CONFIG_DIR. Leave TELLS_REWRITE_OFF=1 until one works.
TELLS_MODEL_BACKEND=anthropic
ANTHROPIC_API_KEY=
TELLS_MODEL=claude-haiku-5-5
TELLS_CLI_CONFIG_DIR=
# With the cli backend, rewrite answers 503 while this file reports TELLS_USAGE_MAX_PCT or more.
TELLS_USAGE_FILE=
TELLS_USAGE_MAX_PCT=85
TELLS_REWRITE_OFF=1
TELLS_DAILY_CALLS=300
TELLS_ANON_REWRITES_PER_IP=3
TELLS_KEY_DAILY_REWRITES=25
TELLS_DAILY_SPEND_USD=2
TELLS_REWRITE_MAX_CHARS=8000
TELLS_KEYS_PER_IP_PER_DAY=3
TELLS_LINT_PER_IP_PER_MINUTE=120
# Opens /stats and /stats.json. Generate a long random value; leave empty to keep them closed.
TELLS_STATS_TOKEN=
