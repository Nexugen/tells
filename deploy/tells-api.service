[Unit]
Description=tells API (lint free, rewrite with a free key)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=tells-api
WorkingDirectory=/opt/tells
EnvironmentFile=/etc/tells-api.env
ExecStart=/usr/local/bin/node /opt/tells/dist/server/index.js
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUQuota=50%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
