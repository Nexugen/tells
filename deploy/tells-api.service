[Unit]
Description=tells API (lint free, rewrite with a free key)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the platform user so rewrite can use the Claude Code login it already has.
User=nexugen
Group=nexugen
StateDirectory=tells-api
Environment=HOME=/var/lib/tells-api
ReadWritePaths=/var/nexugen/agent-accounts/claude
WorkingDirectory=/opt/tells
EnvironmentFile=/etc/tells-api.env
ExecStart=/usr/local/bin/node /opt/tells/dist/server/index.js
Restart=on-failure
RestartSec=3
MemoryMax=1G
CPUQuota=100%
NoNewPrivileges=yes
ProtectSystem=strict
# Every home folder is hidden. If the Claude Code login links into one (here /root/.claude),
# bind just that folder back; the leading - skips it when it does not exist.
ProtectHome=tmpfs
BindPaths=-/root/.claude
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
